// ─── Prisma Schema — VivaceTV ────────────────────────────────────────────────
// Docs: https://pris.ly/d/prisma-schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONTACTED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum LeadType {
  CONTACT
  TEST_GRATUIT
}

// ─── Site settings (key-value store) ─────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Blog posts ───────────────────────────────────────────────────────────────

model Post {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?       @db.Text
  content       String        @db.Text @default("")
  status        ContentStatus @default(DRAFT)
  featuredImage String?

  // SEO
  seoTitle       String?
  seoDescription String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("posts")
}

// ─── Orders ───────────────────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  plan             String
  planDuration     String
  planPrice        Float
  customerName     String
  customerWhatsapp String
  device           String
  message          String?     @db.Text
  status           OrderStatus @default(PENDING)
  notes            String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id       String     @id @default(cuid())
  type     LeadType   @default(CONTACT)
  name     String
  email    String?
  whatsapp String
  device   String?
  subject  String?
  app      String?
  message  String     @db.Text
  status   LeadStatus @default(NEW)
  notes    String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

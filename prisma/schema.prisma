// ─── Prisma Schema — ClarioTV ────────────────────────────────────────────────
// Docs: https://pris.ly/d/prisma-schema
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SUPPORT
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONTACTED
  ACTIVE
  EXPIRED
  CANCELLED
}

enum LeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum LeadType {
  CONTACT
  TEST_GRATUIT
}

// ─── Admin users ─────────────────────────────────────────────────────────────

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         AdminRole @default(EDITOR)
  active       Boolean   @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  lastLogin DateTime?

  // Relations
  posts      Post[]
  pages      Page[]
  mediaAssets MediaAsset[]

  @@map("admin_users")
}

// ─── Site settings (key-value store) ─────────────────────────────────────────

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

// ─── Blog posts ───────────────────────────────────────────────────────────────

model Post {
  id            String        @id @default(cuid())
  title         String
  slug          String        @unique
  excerpt       String?       @db.Text
  content       String        @db.Text @default("")
  status        ContentStatus @default(DRAFT)
  featuredImage String?

  // SEO
  seoTitle       String?
  seoDescription String?

  // Author
  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("posts")
}

// ─── Static pages ─────────────────────────────────────────────────────────────

model Page {
  id      String        @id @default(cuid())
  title   String
  slug    String        @unique
  content String        @db.Text @default("")
  status  ContentStatus @default(DRAFT)

  // SEO
  seoTitle       String?
  seoDescription String?

  // Author
  authorId String
  author   AdminUser @relation(fields: [authorId], references: [id])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("pages")
}

// ─── Orders (commandes) ───────────────────────────────────────────────────────

model Order {
  id               String      @id @default(cuid())
  plan             String
  planDuration     String
  planPrice        Float
  customerName     String
  customerWhatsapp String
  device           String
  message          String?     @db.Text
  status           OrderStatus @default(PENDING)
  notes            String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

// ─── Leads ────────────────────────────────────────────────────────────────────

model Lead {
  id       String     @id @default(cuid())
  type     LeadType   @default(CONTACT)
  name     String
  email    String?
  whatsapp String
  device   String?
  subject  String?
  app      String?
  message  String     @db.Text
  status   LeadStatus @default(NEW)
  notes    String?    @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("leads")
}

// ─── Media assets ─────────────────────────────────────────────────────────────

model MediaAsset {
  id       String @id @default(cuid())
  filename String
  url      String
  mimeType String
  size     Int
  altText  String?

  uploadedById String
  uploadedBy   AdminUser @relation(fields: [uploadedById], references: [id])

  createdAt DateTime @default(now())

  @@map("media_assets")
}
